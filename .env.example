# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored - never commit real secrets to this file.

# --- Supabase ---------------------------------------------------------------
# Project URL and anon (public) key, from Supabase dashboard > Project
# Settings > API. Safe to expose to the browser (NEXT_PUBLIC_) - every table
# they can reach is still governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key, from the same API settings page. This bypasses Row Level
# Security entirely - it must stay server-side only (src/lib/supabase/admin.ts
# is the only place that reads it, guarded by `import 'server-only'`). Never
# prefix this with NEXT_PUBLIC_, never log it, never send it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (contact form) ---------------------------------------------------
# Resend API key, from https://resend.com/api-keys. Used only by
# src/app/api/contact/route.ts (server-side) to send the contact form to the
# studio's inbox. Without it, /contact's POST /api/contact returns a 500.
RESEND_API_KEY=

# Where contact-form submissions are delivered. Defaults to
# nmi.ahlam@gmail.com if unset.
CONTACT_TO_EMAIL=

# --- Site -------------------------------------------------------------------
# The site's public, absolute URL - no trailing slash. Used for SEO metadata
# (canonical/Open Graph URLs in every page's <head>) and for building
# absolute URLs in app/sitemap.ts and app/robots.ts. Falls back to
# http://localhost:3000 if unset, which is fine for local dev but MUST be set
# to the real production domain before launch (see docs/LAUNCH-CHECKLIST.md).
NEXT_PUBLIC_SITE_URL=
